{
  "name": "nicholas-gittins-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && tailwindcss -i src/styles.css -o dist/assets/styles.css --minify",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "deploy": "npm run build && npm run check && npx --yes wrangler@4.86.0 pages deploy dist --project-name nicholas-gittins --branch main"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
